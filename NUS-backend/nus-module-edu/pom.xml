<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.edu.zknu</groupId>
        <artifactId>nus-backend</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>nus-module-edu</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        edu 模块下，处理教育业务，例如班级管理、教师管理、学生管理等。
    </description>

    <dependencies>
        <dependency>
            <groupId>cn.edu.zknu</groupId>
            <artifactId>nus-module-system</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.edu.zknu</groupId>
            <artifactId>nus-module-capacity</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.edu.zknu</groupId>
            <artifactId>nus-module-ai</artifactId>
            <version>${revision}</version>
            <exclusions>
                <exclusion>
                    <groupId>io.swagger.core.v3</groupId>
                    <artifactId>swagger-annotations</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 显式引入swagger-annotations，解决ai模块排除导致的版本冲突 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.38</version>
        </dependency>

        <!-- 业务组件 -->
        <dependency>
            <groupId>cn.edu.zknu</groupId>
            <artifactId>nus-spring-boot-starter-biz-data-permission</artifactId>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>cn.edu.zknu</groupId>
            <artifactId>nus-spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- HTML 解析（校园资讯抓取） -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>cn.edu.zknu</groupId>
            <artifactId>nus-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <!-- Job 相关：用于对接任务中心 JobHandler -->
        <dependency>
            <groupId>cn.edu.zknu</groupId>
            <artifactId>nus-spring-boot-starter-job</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.edu.zknu</groupId>
            <artifactId>nus-spring-boot-starter-protection</artifactId>
        </dependency>

        <!-- Excel 相关 -->
        <dependency>
            <groupId>cn.edu.zknu</groupId>
            <artifactId>nus-spring-boot-starter-excel</artifactId>
        </dependency>

        <!-- 服务端 PDF 报表 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.5</version>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>cn.edu.zknu</groupId>
            <artifactId>nus-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 模块边界守护：edu 只能经 capacity、ai 的 api 包访问这两个模块 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
        <!-- 连接真实 MySQL 的集成测试（标签 db，只在 -Pdb-it 时运行）；版本由 spring-boot-dependencies 管理 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- 它自带的 commons-compress 1.24 离得更近，会顶掉 POI 需要的新版本，导致 Excel 相关单测 NoSuchMethodError -->
                <exclusion>
                    <groupId>org.apache.commons</groupId>
                    <artifactId>commons-compress</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <properties>
        <!-- 默认跳过需要 Docker 的 db 集成测试；-Pdb-it 时只跑 db 集成测试 -->
        <edu.test.groups></edu.test.groups>
        <edu.test.excludedGroups>db</edu.test.excludedGroups>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <groups>${edu.test.groups}</groups>
                    <excludedGroups>${edu.test.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            连接真实数据库的集成测试：Testcontainers 用本地已有的 mysql:8.4.6 镜像（不拉取），
            导入基线 SQL 后依次执行迁移脚本。用法见 cn.nus.zknu.module.edu.dbit.support.EduDbIntegrationTest。
        -->
        <profile>
            <id>db-it</id>
            <properties>
                <edu.test.groups>db</edu.test.groups>
                <edu.test.excludedGroups></edu.test.excludedGroups>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <argLine>-Duser.timezone=Asia/Shanghai</argLine>
                            <environmentVariables>
                                <TZ>Asia/Shanghai</TZ>
                            </environmentVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
